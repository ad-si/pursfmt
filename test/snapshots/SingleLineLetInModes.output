module SingleLineLetInModes where

-- Simple let expression that fits on one line
simple =
  let
    x = 42
  in
    x + 1

-- Comments attached to let or in must keep the multiline form
keywordComments =
  let -- keep let
    x = 1
  in -- keep in
    x

bindingComment =
  let
    x = 1 -- keep binding
  in
    x

bodyComment =
  let
    x = 1
  in
    x -- keep body

-- Let in lambda argument
lambdaArgument f =
  map
    ( \x ->
        let
          y = f x
        in
          Tuple y x
    )

-- Pattern bindings are a primary use case for single-line let
patternLet =
  let
    Tuple a b = tuple
  in
    a + b

recordPattern =
  let
    { yes, no } = result
  in
    yes <> no

complexRecordPattern =
  let
    { left: Tuple a b, right: Tuple c d, tag } = value
  in
    a + b + c + d

typedExpression =
  let
    x = value :: TypeOne TypeTwo TypeThree TypeFour TypeFive TypeSix TypeSeven
  in
    x

typedPattern =
  let
    (x :: TypeOne TypeTwo TypeThree TypeFour TypeFive TypeSix TypeSeven) = value
  in
    x

-- Multiple bindings should never be collapsed by single-line-let-in
multiple =
  let
    a = 1
    b = 2
  in
    a + b

-- Nested lets should not collapse the outer let in smart mode
nested =
  let
    outer = 10
  in
    let
      inner = 20
    in
      outer + inner

-- Lambda bindings are too structurally complex for smart mode
letWithLambda =
  let
    f = \x -> x + 1
  in
    f 42

-- The let itself is simple even though it appears under a lambda
lambdaBody = \x ->
  let
    y = x * 2
  in
    y + 1

-- Case bodies are too structurally complex for smart mode
complexBody =
  let
    x = 1
  in
    case x of
      1 -> "one"
      _ -> "other"

-- Long nested applications should not become one physical line in smart mode
longApplication xss acc =
  let
    heads_tails = catMaybes (map uncons xss)
  in
    f (Tuple (map (_.tail) heads_tails) (map (_.head) heads_tails <> acc))

-- Regression for the real-world let-bound function case
interleaveLike xss =
  let
    f :: Tuple (Array (Array a)) (Array a) -> Tuple (Array (Array a)) (Array a)
    f (Tuple [] acc) = Tuple [] acc
    f (Tuple xss' acc) =
      let
        heads_tails = catMaybes (map uncons xss')
      in
        f (Tuple (map (_.tail) heads_tails) (map (_.head) heads_tails <> acc))
  in
    snd (f (Tuple xss []))

-- @format --let-clause-same-line --single-line-let-in smart --align-clauses-full
module SingleLineLetInModes where

-- Simple let expression that fits on one line
simple = let x = 42 in x + 1

-- Comments attached to let or in must keep the multiline form
keywordComments =
  let -- keep let
    x = 1
  in -- keep in
    x

bindingComment =
  let
    x = 1 -- keep binding
  in
    x

bodyComment =
  let
    x = 1
  in
    x -- keep body

-- Let in lambda argument
lambdaArgument f =
  map
    ( \x -> let y = f x in Tuple y x
    )

-- Pattern bindings are a primary use case for single-line let
patternLet = let Tuple a b = tuple in a + b

recordPattern = let { yes, no } = result in yes <> no

complexRecordPattern =
  let { left: Tuple a b, right: Tuple c d, tag } = value
  in  a + b + c + d

typedExpression =
  let x = value :: TypeOne TypeTwo TypeThree TypeFour TypeFive TypeSix TypeSeven
  in  x

typedPattern =
  let (x :: TypeOne TypeTwo TypeThree TypeFour TypeFive TypeSix TypeSeven) = value
  in  x

-- Multiple bindings should never be collapsed by single-line-let-in
multiple =
  let a = 1
      b = 2
  in  a + b

-- Nested lets should not collapse the outer let in smart mode
nested =
  let outer = 10
  in  let inner = 20 in outer + inner

-- Lambda bindings are too structurally complex for smart mode
letWithLambda =
  let f = \x -> x + 1
  in  f 42

-- The let itself is simple even though it appears under a lambda
lambdaBody = \x -> let y = x * 2 in y + 1

-- Case bodies are too structurally complex for smart mode
complexBody =
  let x = 1
  in  case x of
        1 -> "one"
        _ -> "other"

-- Long nested applications should not become one physical line in smart mode
longApplication xss acc =
  let heads_tails = catMaybes (map uncons xss)
  in  f (Tuple (map (_.tail) heads_tails) (map (_.head) heads_tails <> acc))

-- Regression for the real-world let-bound function case
interleaveLike xss =
  let f :: Tuple (Array (Array a)) (Array a) -> Tuple (Array (Array a)) (Array a)
      f (Tuple [] acc) = Tuple [] acc
      f (Tuple xss' acc) =
        let heads_tails = catMaybes (map uncons xss')
        in  f (Tuple (map (_.tail) heads_tails) (map (_.head) heads_tails <> acc))
  in  snd (f (Tuple xss []))

-- @format --single-line-let-in always
module SingleLineLetInModes where

-- Simple let expression that fits on one line
simple = let x = 42 in x + 1

-- Comments attached to let or in must keep the multiline form
keywordComments =
  let -- keep let
    x = 1
  in -- keep in
    x

bindingComment =
  let
    x = 1 -- keep binding
  in
    x

bodyComment =
  let
    x = 1
  in
    x -- keep body

-- Let in lambda argument
lambdaArgument f =
  map
    ( \x -> let y = f x in Tuple y x
    )

-- Pattern bindings are a primary use case for single-line let
patternLet = let Tuple a b = tuple in a + b

recordPattern = let { yes, no } = result in yes <> no

complexRecordPattern = let { left: Tuple a b, right: Tuple c d, tag } = value in a + b + c + d

typedExpression = let x = value :: TypeOne TypeTwo TypeThree TypeFour TypeFive TypeSix TypeSeven in x

typedPattern = let (x :: TypeOne TypeTwo TypeThree TypeFour TypeFive TypeSix TypeSeven) = value in x

-- Multiple bindings should never be collapsed by single-line-let-in
multiple =
  let
    a = 1
    b = 2
  in
    a + b

-- Nested lets should not collapse the outer let in smart mode
nested = let outer = 10 in let inner = 20 in outer + inner

-- Lambda bindings are too structurally complex for smart mode
letWithLambda = let f = \x -> x + 1 in f 42

-- The let itself is simple even though it appears under a lambda
lambdaBody = \x -> let y = x * 2 in y + 1

-- Case bodies are too structurally complex for smart mode
complexBody =
  let
    x = 1
  in
    case x of
      1 -> "one"
      _ -> "other"

-- Long nested applications should not become one physical line in smart mode
longApplication xss acc = let heads_tails = catMaybes (map uncons xss) in f (Tuple (map (_.tail) heads_tails) (map (_.head) heads_tails <> acc))

-- Regression for the real-world let-bound function case
interleaveLike xss =
  let
    f :: Tuple (Array (Array a)) (Array a) -> Tuple (Array (Array a)) (Array a)
    f (Tuple [] acc) = Tuple [] acc
    f (Tuple xss' acc) = let heads_tails = catMaybes (map uncons xss') in f (Tuple (map (_.tail) heads_tails) (map (_.head) heads_tails <> acc))
  in
    snd (f (Tuple xss []))

